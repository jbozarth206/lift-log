 rest.", "updated": "2026-11-20"}, "mwk3zv2sjf5qx": {"sets": [{"weight": 40, "reps": 12}, {"weight": 40, "reps": 12}], "note": "Finisher. Last 40x10 on all sets: go for 12.", "updated": "2026-11-20"}, "mwcf199pmuq5x": {"sets": [{"weight": 70, "reps": 9}, {"weight": 70, "reps": 8}, {"weight": 70, "reps": 8}], "note": "Last 75x6, 65x10. 70s for 8-9, full depth.", "updated": "2026-11-20"}, "mwcf199pqrb69": {"sets": [{"weight": 110, "reps": 12}, {"weight": 110, "reps": 12}, {"weight": 110, "reps": 11}, {"weight": 110, "reps": 11}, {"weight": 110, "reps": 10}, {"weight": 110, "reps": 10}, {"weight": 110, "reps": 10}], "note": "FST-7, 35 s rest. Hold 110 until all 7 hit 12.", "updated": "2026-11-20"}, "mwcf199phclse": {"sets": [{"weight": 180, "reps": 15}, {"weight": 180, "reps": 14}, {"weight": 180, "reps": 13}], "note": "+1 rep per set, then add weight.", "updated": "2026-11-20"}, "mwk3zv2sarpzl": {"sets": [{"weight": 100, "reps": 8}, {"weight": 100, "reps": 8}, {"weight": 100, "reps": 8}], "note": "Last 100x7 twice, 110x5. Own 100 for 8, strict.", "updated": "2026-11-20"}, "mwk3zv2spojaf": {"sets": [{"weight": 30, "reps": 9}, {"weight": 30, "reps": 9}, {"weight": 30, "reps": 8}], "note": "Last 30x8. Full stretch at the bottom.", "updated": "2026-11-20"}, "mwk3zv2snxssw": {"sets": [{"weight": 50, "reps": 12}, {"weight": 50, "reps": 12}, {"weight": 50, "reps": 11}, {"weight": 50, "reps": 11}, {"weight": 50, "reps": 10}, {"weight": 50, "reps": 10}, {"weight": 50, "reps": 10}], "note": "FST-7, 35 s rest. Last 60x10, so 50 for 7 sets.", "updated": "2026-11-20"}, "mwk3zv2srf6d7": {"sets": [{"weight": 95, "reps": 9}, {"weight": 95, "reps": 8}, {"weight": 95, "reps": 8}], "note": "Last 90x11, 100x7. Elbows in.", "updated": "2026-11-20"}, "mwk3zv2svc269": {"sets": [{"weight": 112, "reps": 9}, {"weight": 112, "reps": 9}, {"weight": 112, "reps": 8}], "note": "Last 112x8 twice. +1 rep.", "updated": "2026-11-20"}, "mwk3zv2s7ijz3": {"sets": [{"weight": 92, "reps": 12}, {"weight": 92, "reps": 12}, {"weight": 92, "reps": 11}, {"weight": 92, "reps": 11}, {"weight": 92, "reps": 10}, {"weight": 92, "reps": 10}, {"weight": 92, "reps": 10}], "note": "FST-7, 35 s rest. Last 112x12 straight sets, 92 for 7.", "updated": "2026-11-20"}, "mwcf199p92ng5": {"sets": [{"weight": 135, "reps": 6}, {"weight": 135, "reps": 6}, {"weight": 140, "reps": 5}, {"weight": 140, "reps": 5}, {"weight": 140, "reps": 4}], "note": "140x5 last time (e1RM up ~15% in a week). Own 140 across sets before 145.", "updated": "2026-11-20", "phase": "bulk"}, "mwcf199pwjnp2": {"sets": [{"weight": 137, "reps": 12}, {"weight": 137, "reps": 12}, {"weight": 137, "reps": 12}, {"weight": 137, "reps": 12}], "note": "Hit 15s across: load up. Pause at the face.", "updated": "2026-11-20", "phase": "bulk"}, "mwcf199ph25hv": {"sets": [{"weight": 82, "reps": 10}, {"weight": 92, "reps": 8}, {"weight": 92, "reps": 8}], "note": "Own 92 for 2 sets. No swinging.", "updated": "2026-11-20", "phase": "bulk"}, "mwcf199pydfhw": {"sets": [{"weight": 235, "reps": 10}, {"weight": 235, "reps": 10}, {"weight": 235, "reps": 9}, {"weight": 235, "reps": 9}], "note": "225x13 was too light: heavier, 1s squeeze at top.", "updated": "2026-11-20", "phase": "bulk"}, "mwcf199pjpfzl": {"sets": [{"weight": 435, "reps": 8}, {"weight": 475, "reps": 8}, {"weight": 475, "reps": 8}, {"weight": 485, "reps": 7}], "note": "Both 475 sets to 8, then try 485.", "updated": "2026-11-20", "phase": "bulk"}, "mwch4fbvt8g1b": {"sets": [{"weight": 75, "reps": 8}, {"weight": 85, "reps": 7}, {"weight": 85, "reps": 6}], "note": "75x8 was easy: add a plate step.", "updated": "2026-11-20", "phase": "bulk"}, "mwch4fbvi9k95": {"sets": [{"weight": 295, "reps": 8}, {"weight": 345, "reps": 7}, {"weight": 345, "reps": 6}], "note": "Hit 335x8: up to 345.", "updated": "2026-11-20", "phase": "bulk"}, "mwch4fbud70m5": {"sets": [{"weight": 172, "reps": 8}, {"weight": 192, "reps": 8}, {"weight": 202, "reps": 7}, {"weight": 212, "reps": 6}], "note": "212x5 last 