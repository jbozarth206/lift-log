  "prescriptions": {"mwcf199pe711c": {"sets": [{"weight": 325, "reps": 5}, {"weight": 265, "reps": 8}, {"weight": 265, "reps": 8}], "note": "Top set 325x5 (last 325x4), then 2 back-offs at 265. Same depth every rep.", "updated": "2026-11-20"}, "mwch4fbvpedbh": {"sets": [{"weight": 340, "reps": 8}, {"weight": 300, "reps": 10}, {"weight": 300, "reps": 10}], "note": "Last 360x6. Top set 340x8, back-offs 300x10, 3 s down.", "updated": "2026-11-20"}, "mwcf199p6uoqa": {"sets": [{"weight": null, "reps": 10}, {"weight": null, "reps": 10}, {"weight": null, "reps": 10}], "note": "New. Pick a load you could do 12 with (about 225-275). Log it so I can progress it.", "updated": "2026-11-20"}, "mwch4fbv9phrj": {"sets": [{"weight": null, "reps": 12}, {"weight": null, "reps": 12}, {"weight": null, "reps": 12}], "note": "New. Pick a load for 12 with a 1 s squeeze.", "updated": "2026-11-20"}, "mwcf199pfd7f7": {"sets": [{"weight": null, "reps": 12}, {"weight": null, "reps": 12}, {"weight": null, "reps": 12}, {"weight": null, "reps": 12}, {"weight": null, "reps": 12}, {"weight": null, "reps": 12}, {"weight": null, "reps": 12}], "note": "FST-7. Same weight all 7 sets, 30-45 s rest.", "updated": "2026-11-20"}, "mwch4fbvzzazg": {"sets": [{"weight": 345, "reps": 10}, {"weight": 345, "reps": 10}, {"weight": 345, "reps": 10}, {"weight": 345, "reps": 10}], "note": "Beat last week (8-10 at 345). All 4 at 10, then +10 lb.", "updated": "2026-11-20"}, "mwch4fbvjsb7m": {"sets": [{"weight": null, "reps": 15}, {"weight": null, "reps": 15}, {"weight": null, "reps": 15}], "note": "New. Pick a load for 15 with a full stretch.", "updated": "2026-11-20"}, "mwch4fbva4bs5": {"sets": [{"weight": 235, "reps": 5}, {"weight": 195, "reps": 8}, {"weight": 195, "reps": 8}], "note": "Top set 235x5 (last 235x4), back-offs 195x8. Touch high chest.", "updated": "2026-11-20"}, "mwcf199p1iw2a": {"sets": [{"weight": 85, "reps": 10}, {"weight": 85, "reps": 9}, {"weight": 85, "reps": 8}], "note": "Last 85x8, 90x6. Own the