  "message": "Coach (Thu): No lifting logged Wed or Thu. Next up is Legs (quads): squat 325x5 top set, hack 360x7, leg press 475x8 twice. Targets are unchanged since you haven't hit them yet. Then Chest upper, Back upper. Food: breakfast logged today, keep going: tap Log meal on all 6 meals, 4,000 kcal / 250 g protein. Weigh in every morning, fasted, after the bathroom. Incline walk 25 min Fri. Tick the Today card so I can see it.",
  "nutrition": {"bulk": {"kcal": 4000, "p": 250, "c": 500, "f": 110}, "cut": {"kcal": 3200, "p": 275, "c": 320, "f": 90}},
  "prescriptions": {"mwcf199pqrb69": {"sets": [{"weight": 110, "reps": 12}, {"weight": 110, "reps": 12}, {"weight": 110, "reps": 11}, {"weight": 110, "reps": 11}, {"weight": 110, "reps": 10}, {"weight": 110, "reps": 10}, {"weight": 110, "reps": 10}], "note": "FST-7: 7 sets, 35s rest. Hold 110 until all 7 hit 12.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199p92ng5": {"sets": [{"weight": 135, "reps": 6}, {"weight": 135, "reps": 6}, {"weight": 140, "reps": 5}, {"weight": 140, "reps": 5}, {"weight": 140, "reps": 4}], "note": "140x5 last time (e1RM up ~15% in a week). Own 140 across sets before 145.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199pwjnp2": {"sets": [{"weight": 137, "reps": 12}, {"weight": 137, "reps": 12}, {"weight": 137, "reps": 12}, {"weight": 137, "reps": 12}], "note": "Hit 15s across: load up. Pause at the face.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199pmuq5x": {"sets": [{"weight": 70, "reps": 8}, {"weight": 70, "reps": 8}, {"weight": 75, "reps": 6}, {"weight": 75, "reps": 6}], "note": "65x10 last time: up to 70s. Full depth, no bounce.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199phclse": {"sets": [{"weight": 180, "reps": 15}, {"weight": 180, "reps": 14}, {"weight": 180, "reps": 13}], "note": "+1 rep per set, then add weight.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199ph25hv": {"sets": [{"weight": 82, "reps": 10}, {"weight": 92, "reps": 8}, {"weight": 92, "reps": 8}], "note": "Own 92 for 2 sets. No swinging.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199pydfhw": {"sets": [{"weight": 235, "reps": 10}, {"weight": 235, "reps": 10}, {"weight": 235, "reps": 9}, {"weight": 235, "reps": 9}], "note": "225x13 was too light: heavier, 1s squeeze at top.", "updated": "2026-11-19", "phase": "bulk"}, "mwch4fbvzzazg": {"sets": [{"weight": 345, "reps": 10}, {"weight": 345, "reps": 9}, {"weight": 345, "reps": 9}, {"weight": 345, "reps": 8}], "note": "All work sets at 345. Full stretch, 1s pause at bottom.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199pe711c": {"sets": [{"weight": 295, "reps": 6}, {"weight": 305, "reps": 6}, {"weight": 315, "reps": 5}, {"weight": 315, "reps": 5}, {"weight": 325, "reps": 5}], "note": "Top set 325x5 (last 325x4). Same depth every rep.", "updated": "2026-11-19", "phase": "bulk"}, "mwch4fbvpedbh": {"sets": [{"weight": 320, "reps": 8}, {"weight": 340, "reps": 8}, {"weight": 360, "reps": 7}, {"weight": 360, "reps": 6}], "note": "+1 rep on the 360 set.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199pjpfzl": {"sets": [{"weight": 435, "reps": 8}, {"weight": 475, "reps": 8}, {"weight": 475, "reps": 8}, {"weight": 485, "reps": 7}], "note": "Both 475 sets to 8, then try 485.", "updated": "2026-11-19", "phase": "bulk"}, "mwch4fbva4bs5": {"sets": [{"weight": 185, "reps": 6}, {"weight": 225, "reps": 6}, {"weight": 225, "reps": 5}, {"weight": 235, "reps": 5}, {"weight": 235, "reps": 4}], "note": "Last 235x4: go for 235x5. Touch high chest.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199p1iw2a": {"sets": [{"weight": 75, "reps": 8}, {"weight": 85, "reps": 8}, {"weight": 90, "reps": 7}, {"weight": 90, "reps": 6}], "note": "+1 rep on the 90s.", "updated": "2026-11-19", "phase": "bulk"}, "mwch4fbvt8g1b": {"sets": [{"weight": 75, "reps": 8}, {"weight": 85, "reps": 7}, {"weight": 85, "reps": 6}], "note": "75x8 was easy: add a plate step.", "updated": "2026-11-19", "phase": "bulk"}, "mwch4fbvi9k95": {"sets": [{"weight": 295, "reps": 8}, {"weight": 345, "reps": 7}, {"weight": 345, "reps": 6}], "note": "Hit 335x8: up to 345.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199pqk0fr": {"sets": [{"weight": 65, "reps": 7}, {"weight": 65, "reps": 6}, {"weight": 65, "reps": 6}, {"weight": 60, "reps": 7}], "note": "Weight = added load. Hit +60x8 twice: go +65.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199pucr7t": {"sets": [{"weight": 192, "reps": 8}, {"weight": 212, "reps": 8}, {"weight": 212, "reps": 7}, {"weight": 222, "reps": 6}], "note": "232 was too heavy (5 reps). Build back up through 212.", "updated": "2026-11-19", "phase": "bulk"}, "mwch4fbud70m5": {"sets": [{"weight": 172, "reps": 8}, {"weight": 192, "reps": 8}, {"weight": 202, "reps": 7}, {"weight": 212, "reps": 6}], "note": "212x5 last time: get 212x6 with a full stretch.", "updated": "2026-11-19", "phase": "bulk"}, "mwch4fbuvhze6": {"sets": [{"weight": 275, "reps": 8}, {"weight": 295, "reps": 8}, {"weight": 315, "reps": 7}, {"weight": 315, "reps": 6}], "note": "+1 rep at 315. Straps OK.", "updated": "2026-11-19", "phase": "bulk"}, "mwilhkfizcd6b": {"sets": [{"weight": 120, "reps": 8}, {"weight": 140, "reps": 6}, {"weight": 140, "reps": 6}], "note": "Strict, no hip drive.", "updated": "2026-11-19", "phase": "bulk"}, "mwcf199polbew": {"sets": [{"weight": 180, "reps": 12}, {"weight": 192, "reps": 10}, {"weight": 192, "reps": 10}], "note": "204 was too heavy. Own 192 first.", "updated": "2026-11-19", "phase": "bulk"}, "mwch4fbve5rav": {"sets": [{"weight": 130, "reps": 11}, {"weight": 130, "reps": 10}, {"weight": 130, "reps": 10}, {"weight": 130, "reps": 9}], "note": "Hold 130, +1-2 reps per set. All 4 at 12 = add weight.", "updated": "2026-11-19", "phase": "bulk"}},
